generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
  QUARANTINED
}

enum StorageProviderType {
  LOCAL
  S3
  CLOUDFLARE_R2
  AZURE_BLOB
  GCS
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  DEMO
  VISIT
  TASK
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
  RESCHEDULED
  MISSED
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum CandidateStage {
  APPLIED
  SCREENING
  SHORTLISTED
  TECHNICAL_INTERVIEW
  MANAGERIAL_INTERVIEW
  HR_INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAID
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique
  passwordHash      String
  firstName         String
  lastName          String
  isActive          Boolean            @default(true)
  roleId            String             @db.Uuid
  role              Role               @relation(fields: [roleId], references: [id])
  refreshTokens     RefreshToken[]
  uploadedFiles     File[]
  attachments       EntityAttachment[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  assignedLeads     Lead[]             @relation("LeadAssignee")
  createdLeads      Lead[]             @relation("LeadCreator")
  updatedLeads      Lead[]             @relation("LeadUpdater")
  assignedFollowUps FollowUp[]         @relation("FollowUpAssignee")
  createdFollowUps  FollowUp[]         @relation("FollowUpCreator")
  createdJobs       JobOpening[]       @relation("JobCreator")
  createdCandidates Candidate[]        @relation("CandidateCreator")
  createdInvoices   Invoice[]          @relation("InvoiceCreator")
  createdExpenses   Expense[]          @relation("ExpenseCreator")
  approvedExpenses  Expense[]          @relation("ExpenseApprover")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@index([roleId])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  familyId   String    @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model File {
  id              String              @id @default(uuid()) @db.Uuid
  originalName    String
  storedName      String
  mimeType        String
  extension       String
  size            BigInt
  storageProvider StorageProviderType @default(LOCAL)
  storageKey      String              @unique
  checksum        String?
  status          FileStatus          @default(UPLOADING)
  uploadedById    String              @db.Uuid
  uploadedBy      User                @relation(fields: [uploadedById], references: [id])
  entityType      String?
  entityId        String?
  category        String?
  isPublic        Boolean             @default(false)
  attachments     EntityAttachment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@index([uploadedById])
  @@index([entityType, entityId])
  @@index([status])
  @@index([deletedAt])
}

model EntityAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  fileId      String   @db.Uuid
  file        File     @relation(fields: [fileId], references: [id])
  entityType  String
  entityId    String
  category    String
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([fileId, entityType, entityId, category])
  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  module     String
  entityType String?
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model Lead {
  id             String       @id @default(uuid()) @db.Uuid
  leadCode       String       @unique
  firstName      String
  lastName       String?
  companyName    String?
  email          String?
  phone          String
  alternatePhone String?
  source         String?
  status         LeadStatus   @default(NEW)
  priority       LeadPriority @default(MEDIUM)
  industry       String?
  website        String?
  estimatedValue Decimal?     @db.Decimal(18, 2)
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  assignedToId   String?      @db.Uuid
  assignedTo     User?        @relation("LeadAssignee", fields: [assignedToId], references: [id])
  createdById    String       @db.Uuid
  createdBy      User         @relation("LeadCreator", fields: [createdById], references: [id])
  updatedById    String?      @db.Uuid
  updatedBy      User?        @relation("LeadUpdater", fields: [updatedById], references: [id])
  followUps      FollowUp[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([email])
  @@index([deletedAt])
}

model FollowUp {
  id           String         @id @default(uuid()) @db.Uuid
  leadId       String         @db.Uuid
  lead         Lead           @relation(fields: [leadId], references: [id])
  type         FollowUpType
  status       FollowUpStatus @default(PENDING)
  subject      String
  description  String?
  scheduledAt  DateTime
  completedAt  DateTime?
  assignedToId String?        @db.Uuid
  assignedTo   User?          @relation("FollowUpAssignee", fields: [assignedToId], references: [id])
  createdById  String         @db.Uuid
  createdBy    User           @relation("FollowUpCreator", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  @@index([leadId, scheduledAt])
  @@index([assignedToId, status])
}

model JobOpening {
  id             String      @id @default(uuid()) @db.Uuid
  title          String
  code           String      @unique
  department     String
  location       String?
  employmentType String?
  description    String?
  openings       Int         @default(1)
  status         JobStatus   @default(OPEN)
  createdById    String      @db.Uuid
  createdBy      User        @relation("JobCreator", fields: [createdById], references: [id])
  candidates     Candidate[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([status])
}

model Candidate {
  id              String         @id @default(uuid()) @db.Uuid
  candidateCode   String         @unique
  firstName       String
  lastName        String?
  email           String
  phone           String?
  currentCompany  String?
  currentTitle    String?
  experienceYears Decimal?       @db.Decimal(5, 2)
  expectedSalary  Decimal?       @db.Decimal(18, 2)
  skills          String[]
  stage           CandidateStage @default(APPLIED)
  jobId           String?        @db.Uuid
  job             JobOpening?    @relation(fields: [jobId], references: [id])
  resumeFileId    String?        @db.Uuid
  createdById     String         @db.Uuid
  createdBy       User           @relation("CandidateCreator", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([stage, createdAt])
  @@index([jobId])
  @@index([email])
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  taxId     String?
  address   String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
}

model Vendor {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  taxId     String?
  address   String?
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique
  customerId    String        @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime
  subtotal      Decimal       @db.Decimal(18, 2)
  taxAmount     Decimal       @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(18, 2)
  currency      String        @default("INR")
  notes         String?
  createdById   String        @db.Uuid
  createdBy     User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([customerId])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(18, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
}

model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @db.Uuid
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(18, 2)
  paidAt    DateTime
  method    String
  reference String?
  createdAt DateTime @default(now())

  @@index([invoiceId, paidAt])
}

model Expense {
  id            String        @id @default(uuid()) @db.Uuid
  expenseNumber String        @unique
  vendorId      String?       @db.Uuid
  vendor        Vendor?       @relation(fields: [vendorId], references: [id])
  category      String
  description   String
  amount        Decimal       @db.Decimal(18, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(18, 2)
  currency      String        @default("INR")
  expenseDate   DateTime
  status        ExpenseStatus @default(PENDING)
  receiptFileId String?       @db.Uuid
  createdById   String        @db.Uuid
  createdBy     User          @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvedById  String?       @db.Uuid
  approvedBy    User?         @relation("ExpenseApprover", fields: [approvedById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([status, expenseDate])
  @@index([vendorId])
}
